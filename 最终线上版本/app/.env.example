# ===== 本机验证数据库（推荐）=====
# 1. 在 app 目录执行：npm run db:up
# 2. 把下面几行复制到 .env（不要提交 .env）
# 3. 停掉再重新 npm run dev（改环境变量必须重启）
# APP_SECRET=dev-local-secret
# DATABASE_URL=mysql://tongzhuo:tongzhuo@127.0.0.1:3307/tongzhuo
# INVITE_CODE=RDFZNB
# ADMIN_PASSWORD=请换成只有组织者知道的后台密码

# 前端多通道入口（可选，不配则不展示）
# VITE_WECOM_KF_URL=企业微信客服链接（结果页「添加月老」按钮）
# VITE_MP_ACCOUNT_URL=公众号链接（页脚）
# VITE_MINIPROGRAM_URL=小程序链接（页脚）

# 微信月老机器人（T2，不配则机器人完全关闭，网站照常运行）
# WECOM_CORPID=企业ID
# WECOM_KF_SECRET=微信客服 Secret
# WECOM_KF_OPENID=客服帐号 open_kfid
# WECOM_TOKEN=回调 Token
# WECOM_AES_KEY=回调 EncodingAESKey（43 位）
# LLM_API_KEY=Moonshot/Kimi API key（不配则闲聊用占位回复、需求抽取写 mock 值）
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=kimi-k2-0905-preview

# T5 合规（可选）
# FIELD_ENCRYPTION_KEY=字段级加密密钥（聊天记录/择偶需求 AES-256-GCM；不配则明文，仅本地开发接受）
# CONTENT_SAFETY_URL=第三方内容安全 API（接口位预留，响应格式 {"ok":bool,"reason"?}）
# MATCH_AGE_GAP=5（匹配年龄差上限，默认 ±5 岁）

# 不配 DATABASE_URL 时：作答、报名、访问统计都不会入库。
# 手机号登录验证码走 TENCENT_* 或 ALIYUN_*。匹配短信（介绍、小纸条、确认）走同一套通道。
# 开发模式（未配短信且非生产）也能测登录：sendLoginCode 返回 devCode，验证码直接显示在页面上。
# 通知模板只有一个变量，整段正文放进这个变量。不配通知模板时，回退到验证码模板。
# TENCENT_SMS_NOTIFY_TEMPLATE_ID=
# SMS_NOTIFY_TEMPLATE=
# 上行短信回调：POST /api/sms/inbound  { "from": "手机号", "text": "正文" }
# /admin 必须输入 ADMIN_PASSWORD；线上务必设置，且不要用示例值。

# ===== 线上 =====
# APP_ID=tongzhuo
# APP_SECRET=换成足够长的随机串
# DATABASE_URL=mysql://用户名:密码@127.0.0.1:3306/tongzhuo
# INVITE_CODE=RDFZNB
# ADMIN_PASSWORD=换成足够长的后台密码
